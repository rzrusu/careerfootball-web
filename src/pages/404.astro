---
import Base from '../layouts/Base.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
---

<Base title="Page not found" bodyClass="uses_light_bg" noindex>
  <div class="flex flex-col items-center justify-center space-y-8 py-24 px-4 text-center">
    <h1 class="text-5xl font-black font-work text-[#1F1F1F]">Page not found</h1>
    <p class="text-lg text-gray-600">The page you're looking for doesn't exist.</p>
    <PrimaryButton href="/">Back to home</PrimaryButton>
  </div>
</Base>
