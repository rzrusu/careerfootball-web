---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
---

<Base title="News" description="The latest news and development updates from the Pro Footballer Life team.">
  <PageHeader title="Latest News" subtitle="News and development updates from the team." />
  <main class="max-w-[1200px] mx-auto px-4 py-12 lg:py-20 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => <PostCard {post} />)}
  </main>
</Base>
