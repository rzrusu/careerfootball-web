---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Nav from '../components/Nav.astro';
import Phone from '../components/Phone.astro';
import PostCard from '../components/PostCard.astro';
import { DISCORD_URL } from '../consts';
import matchEngine from '../assets/site/store/match-engine.webp';
import matchOneTwo from '../assets/site/store/match-one-two.webp';
import goal from '../assets/site/store/goal.webp';
import matchRating from '../assets/site/store/match-rating.webp';
import ratingStar from '../assets/site/store/rating-star.webp';
import card16 from '../assets/site/store/card-16.webp';
import card24 from '../assets/site/store/card-24.webp';
import training from '../assets/site/store/training.webp';
import skillUp from '../assets/site/store/skill-up.webp';
import traitUnlocked from '../assets/site/store/trait-unlocked.webp';
import traitFinisher from '../assets/site/store/trait-finisher.webp';
import traitQuickFeet from '../assets/site/store/trait-quick-feet.webp';
import shirt from '../assets/site/store/shirt.webp';
import offer from '../assets/site/store/offer.webp';
import life from '../assets/site/store/life.webp';
import dateEvent from '../assets/site/store/date-event.webp';
import heart from '../assets/site/store/heart.webp';
import loveChip from '../assets/site/store/love-chip.webp';
import country from '../assets/site/store/country.webp';
import england from '../assets/site/store/england.webp';
import win from '../assets/site/store/win.webp';
import shopping from '../assets/site/store/shopping.webp';
import mansion from '../assets/site/store/mansion.webp';
import hypercar from '../assets/site/store/hypercar.webp';
import netWorth from '../assets/site/store/net-worth.webp';
import trophyRoom from '../assets/site/store/trophy-room.webp';
import cup from '../assets/site/store/cup.webp';
import goldenBoot from '../assets/site/store/golden-boot.webp';
import goldenCrown from '../assets/site/store/golden-crown.webp';
import post1 from '../assets/site/post1.webp';
import post2 from '../assets/site/post2.webp';
import post3 from '../assets/site/post3.webp';
import post4 from '../assets/site/post4.webp';
import post5 from '../assets/site/post5.webp';
import post6 from '../assets/site/post6.webp';

const description = 'Become a pro footballer and live out your dream of being a superstar. Play for the biggest clubs, score goals, win awards and build a fortune along the way.';

const posts = (await getCollection('blog')).sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
const [latest, ...older] = posts;
const sidePosts = older.slice(0, 2);

const stats = [['50+', 'Leagues'], ['800+', 'Clubs'], ['24', 'Countries']];

// Half and full size of a cut-out, so Astro never upscales it
const widths = (img: ImageMetadata) => [Math.round(img.width / 2), img.width];

const matchFeatures = [
  { title: 'Take the Shot', text: 'Line it up, pick your corner and beat the keeper yourself.' },
  { title: 'Link Up Play', text: 'Play one-twos and time your runs into the box.' },
  { title: 'Earn Your Rating', text: 'Every big moment counts towards your match rating.' },
];

const lifeTiles = [
  { title: 'Your People', text: "Partners, family, friends and teammates. Look after them, or don't.", bg: '#fbd9e3', fg: '#b8254f' },
  { title: 'Things to Do', text: 'Dates, gifts, nights out, holidays and the big life steps.', bg: '#dcebff', fg: '#1558c0' },
  { title: 'Your Head', text: 'Morale, well-being and even a new language when you move abroad.', bg: '#fbebc8', fg: '#9a6500' },
];

const awards = ['League Titles', 'Domestic Cups', 'Golden Boot', 'Team of the Season', 'Player of the Season', 'Golden Crown'];
const confetti = [
  ['3%', '19%', '#fff', 20], ['82%', '23%', '#fff', 60], ['97%', '24%', '#fff', 15], ['95%', '32%', '#27c4ff', 150],
  ['24%', '59%', '#8ce000', 130], ['23%', '61%', '#ffd23f', 100], ['92%', '-1%', '#ff7a1a', 160],
];

const faqs = [
  ['When does the game come out?', "We're planning to release in the first quarter of 2027. We'll announce the exact date by email and on Discord."],
  ['Can I play it before launch?', "Hopefully! We'll invite players from our waitlist to test the game before release. Join it above to be in with a chance."],
  ['Which devices can I play on?', "It's coming to iOS and Android."],
  ['How much does it cost?', 'Nothing. The core game is free to play, and always will be.'],
  ['Do I need to buy anything?', 'No. Purchases are optional and never needed to enjoy the full base game.'],
  ['Are there ads?', 'Yes, but a one-off purchase turns them off for good.'],
  ['Do I need an internet connection?', 'No. You only need one for optional extras like leaderboards.'],
  ['Which languages will it support?', "The game will launch in several languages. We'll share the full list closer to release."],
];

const heroSizes = '(min-width: 1024px) 270px, 190px';
const eyebrow = 'text-[13px] lg:text-[15px] font-extrabold uppercase tracking-[0.08em]';
const lead = 'text-[17px] lg:text-xl font-medium leading-[1.45]';
---

<Base title="From Prospect to Legend" {description}>
  <section class="stadium relative overflow-hidden px-4 pt-[38px] lg:pt-[58px]" style="--shade: linear-gradient(90deg, rgba(5,23,59,.86), rgba(5,23,59,.68) 45%, rgba(5,23,59,.2));">
    <Nav />
    <div class="relative max-w-[1200px] mx-auto mt-[76px] lg:mt-16 grid lg:grid-cols-[648px_1fr] gap-9 lg:gap-8 items-center">
      <div class="relative z-10 flex flex-col gap-6 lg:gap-8">
        <div class="flex flex-col gap-2.5 lg:gap-3.5">
          <p class="text-[13px] lg:text-base font-extrabold uppercase tracking-[0.08em] text-[#ffd140]">Coming Soon for Mobile Devices</p>
          <h1 class="text-[44px] lg:text-[82px] font-black text-white leading-[0.96] [text-shadow:0_3px_18px_rgba(5,23,59,.55)]">From Prospect<br />to Legend.</h1>
        </div>
        <p class="text-[17px] lg:text-[21px] font-medium text-[#ccd4de] leading-[1.35] [text-shadow:0_1px_8px_rgba(5,23,59,.6)]">{description}</p>
        <div class="flex flex-col lg:flex-row gap-3.5 lg:gap-4">
          <Button href={DISCORD_URL}>Join Discord</Button>
          <Button href="#signup" variant="secondary">Get Early Access</Button>
        </div>
        <dl class="flex items-center gap-[18px] lg:gap-8 pt-1.5 lg:pt-3 text-white">
          {stats.map(([n, l], i) => (
            <>
              {i > 0 && <span class="w-px h-[34px] lg:h-11 bg-white/30"></span>}
              <div class="flex flex-col-reverse gap-0.5">
                <dt class="text-[13px] lg:text-[15px] font-medium text-white/80">{l}</dt>
                <dd class="text-[26px] lg:text-[34px] font-black leading-none">{n}</dd>
              </div>
            </>
          ))}
        </dl>
      </div>
      <div class="relative h-[440px] lg:h-[710px] lg:-mb-2" style="--ray: rgba(255, 216, 74, 0.5);">
        <div class="absolute aspect-square w-[860px] lg:w-[1280px] left-1/2 top-[48%] -translate-x-[45%] -translate-y-1/2"><div class="rays anim-spin w-full"></div></div>
        <div class="glow anim-breathe w-4/5 h-3/5 left-[15%] top-[18%] bg-[#ffc21f]/40"></div>
        <div class="glow anim-breathe w-[95%] h-4/5 left-[2%] top-[8%] bg-[#27a4ff]/40" style="animation-delay:-4s"></div>
        <Phone src={matchEngine} alt="The match engine: lining up a shot at goal in front of a packed stadium" sizes={heroSizes} eager class="anim-hover absolute w-[53%] lg:w-[52%] right-0 top-2 lg:top-[30px] rotate-[6deg]" style="animation-duration:7.5s;animation-delay:-3s" />
        <!-- Both cards and the arrow float as one group so the arrow stays joined to them -->
        <div class="anim-hover absolute inset-0" style="animation-duration:7s;animation-delay:-1s">
          <Image src={card16} alt="Ethan Marlowe's player card at age 16, rated 64" widths={widths(card16)} sizes="(min-width: 1024px) 170px, 120px" loading="eager" class="pop absolute w-[30%] left-[1%] top-[2%] lg:top-[4%] -rotate-[6deg]" />
          <Image src={card24} alt="The same player at age 24, now rated 91" widths={widths(card24)} sizes="(min-width: 1024px) 250px, 180px" loading="eager" class="pop absolute w-[40%] lg:w-[44%] left-[12%] bottom-[3%] lg:bottom-[5%] -rotate-[3deg]" />
          <svg class="absolute z-10 w-[16%] left-[31%] top-[30%] lg:top-[31%] drop-shadow-[0_4px_10px_rgba(5,23,59,.5)]" viewBox="0 0 100 160" fill="none" aria-hidden="true">
            <path d="M6 12 C 60 8, 86 52, 72 138" stroke="#ffd23f" stroke-width="10" stroke-linecap="round" />
            <path d="M54 120 L 71 146 L 90 124" stroke="#ffd23f" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <span style="animation-delay:0s;animation-duration:9s" class="confetti anim-drift bg-[#ffd23f] left-[40%] top-[4%] rotate-[40deg]"></span>
        <span style="animation-delay:-2s;animation-duration:11s" class="confetti anim-drift bg-[#8ce000] left-[60%] top-0 rotate-[110deg]"></span>
        <span style="animation-delay:-5s;animation-duration:10s" class="confetti anim-drift bg-[#27c4ff] right-0 top-[20%] rotate-[20deg]"></span>
        <span style="animation-delay:-7s;animation-duration:12s" class="confetti anim-drift bg-white left-[85%] top-[4%] rotate-[150deg]"></span>
        <span style="animation-delay:-3s;animation-duration:8s" class="confetti anim-drift bg-[#ff7a1a] -left-[2%] top-[42%] rotate-[70deg]"></span>
      </div>
    </div>
  </section>

  {latest && (
    <section class="px-4 py-14 lg:py-[88px]">
      <div class="max-w-[1200px] mx-auto">
        <div class="flex items-center justify-between mb-6 lg:mb-9">
          <h2 class="text-[32px] lg:text-5xl font-black">Latest News</h2>
          <Button href="/blog" variant="dark" class="px-4 lg:px-[22px] py-[9px] lg:py-3 text-sm lg:text-base">View All</Button>
        </div>
        {sidePosts.length ? (
          <div class="grid lg:grid-cols-[720px_1fr] gap-[18px] lg:gap-6">
            <PostCard post={latest} sizes="(min-width: 1024px) 720px, 100vw" />
            <div class="flex flex-col gap-[18px] lg:gap-6">
              {sidePosts.map((post) => <PostCard {post} layout="row" sizes="150px" />)}
            </div>
          </div>
        ) : (
          <PostCard post={latest} layout="wide" sizes="(min-width: 1024px) 720px, 100vw" />
        )}
      </div>
    </section>
  )}

  <section id="features" class="bg-[#f3f5f8] px-4 py-14 lg:py-24 scroll-mt-4">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-[468px_660px] gap-8 lg:gap-[72px] items-center">
      <div class="flex flex-col gap-4 lg:gap-[22px]">
        <p class:list={[eyebrow, 'text-[#1f8a2c]']}>Match Engine</p>
        <h2 class="text-[38px] lg:text-[56px] font-black leading-[1.02]">Score It Yourself</h2>
        <p class:list={[lead, 'text-[#555b63]']}>The match engine puts you on the pitch. When a big chance falls to you, take control and finish it yourself, in front of a packed stadium.</p>
        <ul class="flex flex-col gap-3.5 lg:gap-4 pt-1">
          {matchFeatures.map((f) => (
            <li class="flex gap-3.5">
              <span class="mt-0.5 grid place-items-center w-7 h-7 shrink-0 rounded-full bg-[#2fae3b] text-white" aria-hidden="true">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              </span>
              <p class="text-[15px] lg:text-[17px] font-medium text-[#555b63] leading-[1.45]"><strong class="font-black text-[#1a1a1a]">{f.title}.</strong> {f.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative overflow-hidden rounded-3xl lg:rounded-[36px] aspect-[358/470] lg:aspect-[660/680] bg-gradient-to-br from-[#5fd43c] to-[#137a2a]" style="--ray: rgba(255, 255, 255, 0.22); --ray-blur: 0px;">
        <div class="rays w-[190%] left-1/2 top-[48%] -translate-x-1/2 -translate-y-1/2"></div>
        <Phone src={matchOneTwo} alt="A one-two on the edge of the box" sizes="(min-width: 1024px) 260px, 160px" class="absolute w-[44%] lg:w-[40%] left-[5%] lg:left-[9%] top-[16%] -rotate-[6deg]" />
        <Phone src={matchEngine} alt="Lining up a shot at the top corner" sizes="(min-width: 1024px) 300px, 180px" class="absolute w-[50%] lg:w-[45%] right-[5%] lg:right-[9%] top-[6%] rotate-[4deg]" />
        <Image src={goal} alt="Goal!" widths={widths(goal)} sizes="(min-width: 1024px) 250px, 160px" class="pop absolute w-[44%] lg:w-[38%] left-[3%] lg:left-[5%] top-[5%] -rotate-[6deg]" />
        <Image src={matchRating} alt="A match rating of 9.4" widths={widths(matchRating)} sizes="(min-width: 1024px) 190px, 120px" class="pop absolute w-[34%] lg:w-[29%] right-[3%] lg:right-[5%] bottom-[6%] rotate-[7deg]" />
        <Image src={ratingStar} alt="" widths={[ratingStar.width]} sizes="70px" class="pop absolute w-[12%] lg:w-[10%] right-[30%] lg:right-[28%] bottom-[7%] -rotate-[10deg]" />
      </div>
    </div>
  </section>

  <section class="px-4 py-14 lg:py-[104px]">
    <div class="max-w-[940px] mx-auto text-center flex flex-col gap-3.5 lg:gap-[18px] mb-7 lg:mb-12">
      <p class:list={[eyebrow, 'text-[#0f8a7e]']}>Training</p>
      <h2 class="text-[38px] lg:text-6xl font-black leading-[1.02]">Train Hard. Become a Star.</h2>
      <p class:list={[lead, 'text-[#555b63]']}>Earn XP from matches and training, then spend it on the skills that suit your game. Unlock traits like Finisher and Dead Ball to stand out from the rest.</p>
    </div>
    <div class="relative overflow-hidden max-w-[1200px] mx-auto rounded-3xl lg:rounded-[36px] h-[540px] lg:h-[600px] bg-gradient-to-b from-[#2fd0a4] to-[#0a7a72]" style="--ray: rgba(255, 255, 255, 0.16); --ray-blur: 0px;">
      <div class="rays w-[1100px] lg:w-[1600px] left-1/2 top-[30%] -translate-x-1/2 -translate-y-1/2"></div>
      <Phone src={training} alt="The skills screen with skill levels, XP costs and unlocked traits" sizes="(min-width: 1024px) 320px, 215px" class="absolute w-[60%] lg:w-[320px] left-1/2 -translate-x-1/2 top-6 lg:top-[24px]" />
      <Image src={skillUp} alt="Shooting goes up to 91" widths={widths(skillUp)} sizes="(min-width: 1024px) 380px, 230px" class="pop absolute w-[66%] lg:w-[32%] right-2 lg:right-[6%] top-[22%] lg:top-[14%] -rotate-[4deg]" />
      <Image src={traitUnlocked} alt="Trait unlocked: Dead Ball, you take your side's free kicks and penalties" widths={widths(traitUnlocked)} sizes="(min-width: 1024px) 300px, 180px" class="pop absolute w-[50%] lg:w-[26%] left-2 lg:left-[7%] bottom-4 lg:bottom-auto lg:top-[30%] rotate-[4deg]" />
      <Image src={traitFinisher} alt="" widths={[traitFinisher.width]} sizes="100px" class="pop hidden lg:block absolute w-[8%] right-[12%] bottom-[12%] rotate-[12deg]" />
      <Image src={traitQuickFeet} alt="" widths={[traitQuickFeet.width]} sizes="100px" class="pop absolute w-[18%] lg:w-[7%] right-[6%] lg:right-auto bottom-[8%] lg:bottom-auto lg:left-[12%] lg:top-[9%] -rotate-[10deg]" />
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-b from-[#0a1838] to-[#123a8c] px-4 py-14 lg:py-24">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-[1fr_560px] gap-8 lg:gap-16 items-center">
      <div class="relative z-10 flex flex-col gap-3.5 lg:gap-5">
        <p class:list={[eyebrow, 'text-[#6fb4ff]']}>Transfers</p>
        <h2 class="text-[38px] lg:text-[64px] font-black text-white leading-none">Sign for Your Dream Club</h2>
        <p class:list={[lead, 'text-[#c4cfe2]']}>Play well and bigger clubs come calling. Weigh up the fee, the wages and your place in the squad, then sign the deal and pull on the shirt.</p>
      </div>
      <div class="relative w-full max-w-[420px] lg:max-w-none mx-auto aspect-[560/770]">
        {[['8%', '6%', '#ffd23f', 40], ['88%', '2%', '#27c4ff', 120], ['96%', '44%', '#ff7a1a', 70], ['2%', '52%', '#fff', 150], ['50%', '-2%', '#8ce000', 20]].map(([left, top, color, rotate]) => (
          <span class="confetti" style={`left:${left};top:${top};background:${color};rotate:${rotate}deg`}></span>
        ))}
        <Image src={shirt} alt="A number 39 shirt with Marlowe on the back" widths={widths(shirt)} sizes="(min-width: 1024px) 460px, 320px" class="pop absolute w-[82%] left-[9%] top-0 -rotate-[4deg]" />
        <Image src={offer} alt="Lombardia FC want to sign you for £86.7M, paying £79,000 a week as a starter" widths={widths(offer)} sizes="(min-width: 1024px) 360px, 260px" class="pop absolute w-[60%] left-[24%] bottom-0 -rotate-[3deg]" />
      </div>
    </div>
  </section>

  <section class="bg-[#fff9f2] px-4 py-14 lg:py-[104px]">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-[600px_1fr] gap-8 lg:gap-[72px] items-center">
      <div class="lg:order-2 flex flex-col gap-4 lg:gap-6">
        <div class="flex flex-col gap-3.5 lg:gap-4">
          <p class:list={[eyebrow, 'text-[#b8254f]']}>Life Off the Pitch</p>
          <h2 class="text-[38px] lg:text-[54px] font-black leading-[1.02]">Football Is Only Half of It</h2>
          <p class:list={[lead, 'text-[#555b63]']}>Fall in love, plan the perfect date and start a family. Life throws curveballs too, and what you do between matches matters.</p>
        </div>
        <div class="flex flex-col gap-3">
          {lifeTiles.map((t) => (
            <article class="rounded-[20px] px-5 py-4" style={`background:${t.bg}`}>
              <h3 class="text-xl lg:text-[22px] font-black" style={`color:${t.fg}`}>{t.title}</h3>
              <p class="mt-1 font-medium text-[#3c3f44] leading-[1.35]">{t.text}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="relative overflow-hidden rounded-3xl lg:rounded-[36px] aspect-[358/470] lg:aspect-[600/700] bg-gradient-to-br from-[#ff6fae] to-[#c01a5c]" style="--ray: rgba(255, 255, 255, 0.18); --ray-blur: 0px;">
        <div class="rays w-[190%] left-1/2 top-[40%] -translate-x-1/2 -translate-y-1/2"></div>
        <Phone src={life} alt="Your partner Chloe, things to do together and past events" sizes="(min-width: 1024px) 290px, 180px" class="absolute w-[50%] lg:w-[48%] left-[8%] top-[6%] -rotate-[3deg]" />
        <Image src={heart} alt="" widths={[heart.width]} sizes="80px" class="pop absolute w-[15%] lg:w-[13%] right-[10%] top-[5%] -rotate-[14deg]" />
        <Image src={loveChip} alt="Plus 12 love" widths={[loveChip.width]} sizes="(min-width: 1024px) 130px, 90px" class="pop absolute w-[25%] lg:w-[22%] right-[6%] top-[21%] -rotate-[6deg]" />
        <Image src={dateEvent} alt="The table you booked has gone to someone else. Take the stools at the bar, or use your name to get one?" widths={widths(dateEvent)} sizes="(min-width: 1024px) 340px, 210px" class="pop absolute w-[60%] lg:w-[57%] right-[3%] bottom-[5%] rotate-[4deg]" />
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden px-4 py-14 lg:py-[104px]">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-[1fr_600px] gap-8 lg:gap-[72px] items-center">
      <div class="flex flex-col gap-3.5 lg:gap-5">
        <p class:list={[eyebrow, 'text-[#d42a3c]']}>International</p>
        <h2 class="text-[38px] lg:text-[56px] font-black leading-[1.02]">Play for Your Country</h2>
        <p class:list={[lead, 'text-[#555b63]']}>Get called up to your country's youth teams and work your way into the senior squad. Earn a starting spot, rack up the caps and shine on the biggest stage.</p>
      </div>
      <div class="relative overflow-hidden rounded-3xl lg:rounded-[36px] aspect-[358/470] lg:aspect-[600/700] bg-gradient-to-b from-[#2b5cff] to-[#0b1f7a]">
        <div class="absolute -left-[20%] top-[56%] w-[140%] h-[26%] -rotate-[14deg] bg-gradient-to-r from-[#c8102e] to-[#e8364c] opacity-90"></div>
        <Phone src={country} alt="The England screen: expected to start, games for your country and recent results" sizes="(min-width: 1024px) 270px, 180px" class="absolute w-[50%] lg:w-[45%] left-1/2 -translate-x-1/2 top-[7%]" />
        <Image src={england} alt="England: called up again, and expected to start up front" widths={widths(england)} sizes="(min-width: 1024px) 440px, 300px" class="pop absolute w-[86%] lg:w-[76%] left-[7%] lg:left-[12%] top-[25%] -rotate-[2deg]" />
        <Image src={win} alt="Won 3-0 against France with 2 goals and a 9.1 rating" widths={widths(win)} sizes="(min-width: 1024px) 420px, 290px" class="pop absolute w-[82%] lg:w-[72%] left-[9%] lg:left-[14%] bottom-[8%] rotate-[2deg]" />
      </div>
    </div>
  </section>

  <section class="bg-[#f4efff] px-4 py-14 lg:py-[104px]">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-[600px_1fr] gap-8 lg:gap-[72px] items-center">
      <div class="lg:order-2 flex flex-col gap-3.5 lg:gap-5">
        <p class:list={[eyebrow, 'text-[#6a35d9]']}>Money</p>
        <h2 class="text-[38px] lg:text-[56px] font-black leading-[1.02]">Spend Your Millions</h2>
        <p class:list={[lead, 'text-[#555b63]']}>Big wages mean big decisions. Buy a mansion, a hypercar or a yacht, or build a property portfolio that pays you every month. Then move clubs and do it all again.</p>
      </div>
      <div class="relative overflow-hidden rounded-3xl lg:rounded-[36px] aspect-[358/470] lg:aspect-[600/700] bg-gradient-to-br from-[#9d63ff] to-[#4316b0]" style="--ray: rgba(255, 255, 255, 0.14); --ray-blur: 0px;">
        <div class="rays w-[190%] left-1/2 top-[45%] -translate-x-1/2 -translate-y-1/2"></div>
        <Phone src={shopping} alt="The shopping screen: homes, cars, jewellery, watches, art, boats, planes and collectables" sizes="(min-width: 1024px) 270px, 170px" class="absolute w-[48%] lg:w-[45%] left-[5%] top-[9%] -rotate-[3deg]" />
