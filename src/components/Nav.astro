---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import logo from '../assets/site/logo.webp';
import { DISCORD_URL } from '../consts';

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/blog', label: 'Blog' },
  { href: '/press-kit', label: 'Press' },
];
---

<nav class="relative z-20 w-full max-w-[1200px] mx-auto bg-white rounded-[20px] flex items-center justify-end min-h-14 lg:min-h-[74px] px-[18px] lg:px-5 py-2">
  <a href="/" aria-label="Pro Footballer Life home" class="absolute left-1.5 lg:left-[18px] top-1/2 -translate-y-1/2 w-[215px] lg:w-[330px]">
    <Image src={logo} alt="Pro Footballer Life" widths={[215, 330, 430, 660]} sizes="(min-width: 1024px) 330px, 215px" loading="eager" fetchpriority="high" class="w-full h-auto" />
  </a>
  <div class="hidden lg:flex items-center gap-8">
    {links.map((link) => <a href={link.href} class="font-bold hover:text-[#1a6ff0] transition-colors">{link.label}</a>)}
    <Button href={DISCORD_URL} class="px-[22px] py-3 text-[15px]">Join Discord</Button>
  </div>
  <button type="button" id="nav-toggle" class="lg:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
    </svg>
  </button>
  <div id="mobile-nav" hidden class="absolute top-full inset-x-0 mt-3 bg-white rounded-[20px] p-5 shadow-xl lg:hidden">
    <div class="flex flex-col gap-4">
      {links.map((link) => <a href={link.href} class="font-bold text-lg">{link.label}</a>)}
      <Button href={DISCORD_URL} class="px-6 py-3">Join Discord</Button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('mobile-nav')!;

  toggle.addEventListener('click', () => {
    menu.hidden = !menu.hidden;
    toggle.setAttribute('aria-expanded', String(!menu.hidden));
  });
</script>
