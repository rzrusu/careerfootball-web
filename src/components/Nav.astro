---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import logo from '../assets/logos/logo-big-min.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/#features', label: 'Features' },
  { href: '/blog', label: 'Blog' },
  { href: 'mailto:hello@footballcareer.app', label: 'Contact' },
];
---

<nav class="py-2 2xl:py-8 inline-flex items-center justify-between w-full max-w-7xl mx-auto">
  <a href="/" aria-label="Football Career home">
    <Image
      src={logo}
      alt="Logo"
      widths={[251, 376, 502, 640]}
      sizes="(min-width: 1536px) 376px, (min-width: 1280px) 334px, (min-width: 768px) 293px, 251px"
      format="webp"
      loading="eager"
      class="h-24 md:h-28 xl:h-32 2xl:h-36 w-auto"
    />
  </a>
  <div class="lg:hidden">
    <button type="button" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>
  <div class="bg-white rounded-full py-1 px-6 items-center highlight space-x-2 2xl:space-x-6 hidden lg:inline-flex">
    <ul class="flex justify-between divide-x">
      {links.map((link) => <li><a href={link.href} class="text-sm 2xl:text-base">{link.label}</a></li>)}
    </ul>
    <SocialLinks class="flex justify-between py-0 mt-4 sm:mt-0 md:py-4 px-6 media" />
  </div>
</nav>
<div id="mobile-nav" hidden>
  <div class="bg-white rounded-full w-full py-6 md:py-2 px-6 items-center justify-center highlight space-x-2 2xl:space-x-6 flex flex-col sm:flex-row mb-16">
    <ul class="flex justify-between divide-x">
      {links.map((link) => <li><a href={link.href} class="text-sm 2xl:text-base">{link.label}</a></li>)}
    </ul>
    <SocialLinks class="flex justify-between py-0 mt-4 sm:mt-0 md:py-4 px-6 media" />
  </div>
</div>

<style is:global>
  nav a,
  #mobile-nav a {
    @apply text-black font-semibold hover:text-gray-800 transition;
    text-decoration: none;
  }

  nav li,
  #mobile-nav li {
    @apply px-4;
  }

  nav .media li,
  #mobile-nav .media li {
    @apply px-2;
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('mobile-nav')!;

  toggle.addEventListener('click', () => {
    menu.hidden = !menu.hidden;
    toggle.setAttribute('aria-expanded', String(!menu.hidden));
  });
</script>
