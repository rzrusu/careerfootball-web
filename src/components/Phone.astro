---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
  style?: string;
}

const { src, alt, sizes, eager = false, class: className, style } = Astro.props;
---

<div class:list={['phone', className]} style={style}>
  <Image src={src} {alt} widths={[280, 390, 560, 780]} {sizes} loading={eager ? 'eager' : 'lazy'} />
</div>
